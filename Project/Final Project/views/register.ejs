<!DOCTYPE html>
<html dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/images/favicon.png">
    <title>Register — Admin Panel</title>
    <link href="dist/css/style.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@300;400;500&display=swap');
        :root {
            --bg-base: #0d0f14; --bg-surface: #13161e; --bg-elevated: #1a1e2a; --bg-card: #1e2333;
            --border: rgba(255,255,255,0.07); --indigo: #6366f1; --indigo-light: #818cf8;
            --amber: #f59e0b; --text-primary: #f0f2ff; --text-secondary: #8892b0; --text-muted: #4a5568;
            --success: #10b981;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-base);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        }
        body::before {
            content: ''; position: fixed; top: -200px; left: -200px;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(99,102,241,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        body::after {
            content: ''; position: fixed; bottom: -200px; right: -200px;
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(245,158,11,0.07) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-wrapper {
            width: 100%; max-width: 440px;
            padding: 20px;
            position: relative; z-index: 1;
        }
        .auth-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 32px 80px rgba(0,0,0,0.5);
        }
        .auth-header {
            text-align: center;
            margin-bottom: 28px;
        }
        .auth-header img { height: 36px; margin-bottom: 20px; }
        .auth-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 24px; font-weight: 800;
            color: var(--text-primary); margin-bottom: 6px;
        }
        .auth-header p { font-size: 13px; color: var(--text-muted); }

        .field-wrap { margin-bottom: 14px; }
        .field-label {
            display: block; font-size: 12px; font-weight: 500;
            color: var(--text-secondary); margin-bottom: 6px;
        }
        .field-input-group {
            display: flex; align-items: center;
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: 10px; overflow: hidden;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .field-input-group:focus-within {
            border-color: rgba(99,102,241,0.5);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
        }
        .field-icon { padding: 0 14px; color: var(--text-muted); font-size: 14px; flex-shrink: 0; }
        .field-input-group input {
            flex: 1; background: transparent; border: none; outline: none;
            padding: 11px 14px 11px 0;
            color: var(--text-primary); font-size: 14px; font-family: 'DM Sans', sans-serif;
        }
        .field-input-group input::placeholder { color: var(--text-muted); }

        .auth-actions {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 10px;
            margin-top: 24px; padding-top: 20px;
            border-top: 1px solid var(--border);
        }
        .btn-primary-full {
            padding: 11px 24px; background: var(--indigo); color: #fff;
            border: none; border-radius: 10px; font-size: 14px; font-weight: 600;
            font-family: 'DM Sans', sans-serif; cursor: pointer;
            transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;
        }
        .btn-primary-full:hover { background: var(--indigo-light); transform: translateY(-1px); }
        .btn-ghost {
            padding: 10px 18px; background: transparent; color: var(--text-secondary);
            border: 1px solid var(--border); border-radius: 10px;
            font-size: 13px; font-family: 'DM Sans', sans-serif; cursor: pointer;
            transition: all 0.2s; text-decoration: none;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .btn-ghost:hover { border-color: var(--indigo); color: var(--indigo); }
    </style>
</head>
<body>
    <div class="preloader" style="display:none;"></div>
    <div class="auth-wrapper" style="display: flex; justify-content: center; align-items: center;">
        <div class="auth-card">
            <div class="auth-header">
                <h1>Create Account</h1>
                <p>Fill in the details to register as an admin</p>
            </div>

            <form action="/register" method="post">
                <div class="field-wrap">
                    <label class="field-label">Full Name</label>
                    <div class="field-input-group">
                        <span class="field-icon"><i class="ti-user"></i></span>
                        <input type="text" placeholder="John Doe" name="name" required />
                    </div>
                </div>
                <div class="field-wrap">
                    <label class="field-label">Email Address</label>
                    <div class="field-input-group">
                        <span class="field-icon"><i class="ti-email"></i></span>
                        <input type="email" placeholder="you@example.com" name="email" required />
                    </div>
                </div>
                <div class="field-wrap">
                    <label class="field-label">Password</label>
                    <div class="field-input-group">
                        <span class="field-icon"><i class="ti-lock"></i></span>
                        <input type="password" placeholder="Create a strong password" name="password" required />
                    </div>
                </div>
                <div class="auth-actions">
                    <a href="/" class="btn-ghost"><i class="fa fa-arrow-left"></i> Back to Login</a>
                    <button class="btn-primary-full" type="submit"><i class="fa fa-user-plus"></i> Register</button>
                </div>
            </form>
        </div>
    </div>

    <script src="assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="assets/libs/popper.js/dist/umd/popper.min.js"></script>
    <script src="assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script>$(".preloader").fadeOut();</script>
</body>
</html>
