<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --bg-base: #0d0f14;
    --bg-surface: #13161e;
    --bg-elevated: #1a1e2a;
    --bg-card: #1e2333;
    --border: rgba(255, 255, 255, 0.07);
    --border-accent: rgba(99, 102, 241, 0.4);
    --indigo: #6366f1;
    --indigo-light: #818cf8;
    --amber: #f59e0b;
    --amber-light: #fbbf24;
    --text-primary: #f0f2ff;
    --text-secondary: #8892b0;
    --text-muted: #4a5568;
    --success: #10b981;
    --danger: #ef4444;
    --cyan: #06b6d4;
    --sidebar-width: 260px;
    --header-h: 64px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body,
  html {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg-base);
    color: var(--text-primary);
    min-height: 100vh;
  }

  /* ===== TOPBAR ===== */
  .topbar-custom {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-h);
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 24px;
    z-index: 1000;
    gap: 16px;
  }

  .brand-area {
    width: var(--sidebar-width);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .brand-logo-wrap {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--indigo), var(--amber));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 800;
    color: #fff;
    font-family: 'Syne', sans-serif;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 17px;
    color: var(--text-primary);
    letter-spacing: -0.3px;
  }

  .brand-name img {
    height: 22px;
  }

  .topbar-nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sidebar-toggle-btn {
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    border-radius: 8px;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .sidebar-toggle-btn:hover {
    border-color: var(--indigo);
    color: var(--indigo);
  }

  .topbar-search {
    position: relative;
    max-width: 280px;
    width: 100%;
  }

  .topbar-search input {
    width: 100%;
    padding: 8px 14px 8px 38px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 13px;
    font-family: 'DM Sans', sans-serif;
    transition: border-color 0.2s;
    outline: none;
  }

  .topbar-search input:focus {
    border-color: var(--border-accent);
  }

  .topbar-search .srch-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 13px;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .icon-btn {
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    border-radius: 8px;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    position: relative;
    text-decoration: none;
  }

  .icon-btn:hover {
    border-color: var(--indigo);
    color: var(--indigo);
  }

  .badge-dot {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 7px;
    height: 7px;
    background: var(--amber);
    border-radius: 50%;
    border: 2px solid var(--bg-surface);
  }

  .avatar-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid var(--border-accent);
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .avatar-btn:hover {
    border-color: var(--indigo);
  }

  .avatar-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dropdown menus */
  .custom-dropdown {
    position: relative;
  }

  .custom-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 6px;
    display: none;
    z-index: 9999;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .custom-dropdown:hover .custom-dropdown-menu,
  .custom-dropdown.open .custom-dropdown-menu {
    display: block;
  }

  .custom-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 8px;
    font-size: 13px;
    transition: all 0.15s;
  }

  .custom-dropdown-menu a:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .custom-dropdown-menu hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 4px 0;
  }

  .custom-dropdown-menu a i {
    width: 16px;
    text-align: center;
  }

  /* ===== MAIN LAYOUT ===== */
  #main-wrapper {
    padding-top: var(--header-h);
    display: flex;
    min-height: 100vh;
  }

  .page-wrapper {
    margin-left: var(--sidebar-width);
    flex: 1;
    min-height: calc(100vh - var(--header-h));
    background: var(--bg-base);
    transition: margin-left 0.3s;
  }

  /* ===== PAGE BREADCRUMB ===== */
  .page-breadcrumb {
    padding: 20px 28px 0;
  }

  .page-title {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .breadcrumb {
    background: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .breadcrumb-item a {
    color: var(--text-muted);
    font-size: 12px;
    text-decoration: none;
  }

  .breadcrumb-item.active {
    color: var(--indigo);
    font-size: 12px;
  }

  .breadcrumb-item+.breadcrumb-item::before {
    content: "/";
    color: var(--text-muted);
  }

  /* ===== CARDS ===== */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .card-body {
    padding: 20px 24px;
  }

  .card-title {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .card-subtitle {
    font-size: 12px;
    color: var(--text-secondary);
  }

  /* ===== TABLES ===== */
  .table {
    width: 100%;
    border-collapse: collapse;
    color: var(--text-secondary);
    font-size: 13.5px;
  }

  .table thead tr {
    border-bottom: 1px solid var(--border);
  }

  .table thead th {
    padding: 12px 20px;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-muted);
    background: var(--bg-elevated);
  }

  .table tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }

  .table tbody tr:hover {
    background: rgba(99, 102, 241, 0.05);
  }

  .table tbody td {
    padding: 14px 20px;
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .table tbody td:first-child {
    color: var(--text-muted);
    font-size: 12px;
  }

  /* ===== FORMS ===== */
  .form-control {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    padding: 10px 14px;
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .form-control:focus {
    border-color: var(--border-accent);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  .form-control::placeholder {
    color: var(--text-muted);
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
  }

  .col-form-label {
    font-size: 13px !important;
    color: var(--text-secondary) !important;
    padding-top: 10px;
  }

  select.form-control,
  select {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 14px;
    padding: 10px 14px;
    width: 100%;
    outline: none;
    font-family: 'DM Sans', sans-serif;
  }

  select option {
    background: var(--bg-card);
  }

  .input-group {
    display: flex;
    align-items: stretch;
    margin-bottom: 14px;
  }

  .input-group-prepend {
    display: flex;
  }

  .input-group-text {
    padding: 10px 14px;
    border-radius: 8px 0 0 8px;
    border: 1px solid var(--border);
    border-right: none;
    font-size: 14px;
    display: flex;
    align-items: center;
    min-width: 44px;
    justify-content: center;
  }

  .input-group .form-control {
    border-radius: 0 8px 8px 0;
  }

  .bg-success {
    background: rgba(16, 185, 129, 0.15) !important;
    border-color: rgba(16, 185, 129, 0.3) !important;
    color: var(--success) !important;
  }

  .bg-warning {
    background: rgba(245, 158, 11, 0.15) !important;
    border-color: rgba(245, 158, 11, 0.3) !important;
    color: var(--amber) !important;
  }

  .bg-info {
    background: rgba(6, 182, 212, 0.15) !important;
    border-color: rgba(6, 182, 212, 0.3) !important;
    color: var(--cyan) !important;
  }

  .bg-danger {
    background: rgba(239, 68, 68, 0.15) !important;
    border-color: rgba(239, 68, 68, 0.3) !important;
    color: var(--danger) !important;
  }

  .bg-primary {
    background: rgba(99, 102, 241, 0.15) !important;
    border-color: rgba(99, 102, 241, 0.3) !important;
    color: var(--indigo-light) !important;
  }

  .bg-cyan {
    background: rgba(6, 182, 212, 0.15) !important;
    border-color: rgba(6, 182, 212, 0.3) !important;
    color: var(--cyan) !important;
  }

  /* ===== BUTTONS ===== */
  .btn {
    padding: 9px 18px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--indigo);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--indigo-light);
    transform: translateY(-1px);
  }

  .btn-success {
    background: var(--success);
    color: #fff;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .btn-info {
    background: var(--cyan);
    color: #fff;
  }

  .btn-danger {
    background: var(--danger);
    color: #fff;
  }

  .btn-outline-light {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .btn-outline-light:hover {
    border-color: var(--indigo);
    color: var(--indigo);
  }

  .btn-sm {
    padding: 5px 12px;
    font-size: 12px;
  }

  .btn-cyan {
    background: rgba(6, 182, 212, 0.15);
    color: var(--cyan);
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .btn-cyan:hover {
    background: rgba(6, 182, 212, 0.25);
  }

  /* ===== FOOTER ===== */
  .footer {
    padding: 16px 28px;
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    margin-top: 20px;
  }

  .footer a {
    color: var(--indigo);
    text-decoration: none;
  }

  /* ===== CONTAINER ===== */
  .container-fluid {
    padding: 20px 28px;
  }

  /* ===== BOX CARDS (dashboard) ===== */
  .box {
    padding: 24px 16px;
    border-radius: 12px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .box::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
  }

  .box h1 {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .box h6 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .bg-cyan.box {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(6, 182, 212, 0.05));
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .bg-success.box {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.05));
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .bg-warning.box {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.05));
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .bg-danger.box {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(239, 68, 68, 0.05));
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .bg-info.box {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(6, 182, 212, 0.05));
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  /* ===== PROGRESS BARS ===== */
  .progress {
    height: 5px;
    background: var(--bg-elevated);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 6px;
  }

  .progress-bar {
    height: 100%;
    background: var(--indigo);
    border-radius: 99px;
    transition: width 0.6s ease;
  }

  .progress-bar.bg-success {
    background: var(--success);
  }

  .progress-bar.bg-info {
    background: var(--cyan);
  }

  .progress-bar.bg-danger {
    background: var(--danger);
  }

  .progress-bar.bg-warning {
    background: var(--amber);
  }

  /* ===== CHAT ===== */
  .chat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
  }

  .chat-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .chat-item.odd {
    flex-direction: row-reverse;
  }

  .chat-img img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }

  .chat-content {
    max-width: 75%;
  }

  .chat-content h6 {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .chat-content .box {
    padding: 10px 14px;
    border-radius: 0 10px 10px 10px;
    font-size: 13px;
  }

  .chat-item.odd .chat-content .box {
    border-radius: 10px 0 10px 10px;
    background: rgba(99, 102, 241, 0.15) !important;
    border-color: rgba(99, 102, 241, 0.3) !important;
    color: var(--indigo-light) !important;
  }

  .bg-light-info {
    background: var(--bg-elevated) !important;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .chat-time {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
    align-self: flex-end;
  }

  /* ===== COMMENT WIDGETS ===== */
  .comment-row {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .comment-row img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .comment-text h6 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .comment-text span {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .comment-footer {
    margin-top: 8px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .text-muted {
    color: var(--text-muted) !important;
  }

  .float-right {
    margin-left: auto;
  }

  /* ===== ACCORDION ===== */
  .card-header {
    padding: 14px 20px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .card-header:hover {
    color: var(--indigo);
  }

  /* ===== TABS ===== */
  .nav-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    padding: 0 16px;
    gap: 4px;
  }

  .nav-tabs .nav-item .nav-link {
    padding: 12px 16px;
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }

  .nav-tabs .nav-item .nav-link.active {
    color: var(--indigo);
    border-bottom-color: var(--indigo);
  }

  .tab-content {
    padding: 0;
  }

  .tab-pane.p-20 {
    padding: 20px 24px;
  }

  /* ===== TODO LIST ===== */
  .list-group-item {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
  }

  .custom-control-label {
    color: var(--text-secondary);
    font-size: 13px;
  }

  .badge {
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 6px;
    font-weight: 600;
  }

  .badge-danger {
    background: rgba(239, 68, 68, 0.15);
    color: var(--danger);
  }

  .badge-primary {
    background: rgba(99, 102, 241, 0.15);
    color: var(--indigo-light);
  }

  .badge-info {
    background: rgba(6, 182, 212, 0.15);
    color: var(--cyan);
  }

  .badge-warning {
    background: rgba(245, 158, 11, 0.15);
    color: var(--amber);
  }

  /* ===== NEWS LIST ===== */
  .list-style-none {
    list-style: none;
    padding: 0;
  }

  .card-body.border-top {
    border-top: 1px solid var(--border);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .page-wrapper {
      margin-left: 0;
    }

    .brand-area {
      width: auto;
    }

    .topbar-search {
      display: none;
    }
  }

  /* ===== SCROLLABLE ===== */
  .scrollable {
    overflow-y: auto;
    max-height: 400px;
  }

  .scrollable::-webkit-scrollbar {
    width: 4px;
  }

  .scrollable::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollable::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  /* ===== MISC ===== */
  .flot-chart {
    background: var(--bg-elevated);
    border-radius: 8px;
    min-height: 200px;
  }

  .flot-chart-content {
    height: 200px;
  }

  .btn-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-circle.btn-lg {
    width: 44px;
    height: 44px;
  }

  .w-30px {
    width: 30px;
    flex-shrink: 0;
  }

  .font-medium {
    font-weight: 600;
  }

  .font-light {
    font-weight: 300;
  }

  .border-top {
    border-top: 1px solid var(--border) !important;
  }

  .m-b-0 {
    margin-bottom: 0;
  }

  .m-t-5 {
    margin-top: 5px;
  }

  .m-t-15 {
    margin-top: 15px;
  }

  .m-t-20 {
    margin-top: 20px;
  }

  .m-t-25 {
    margin-top: 25px;
  }

  .m-b-5 {
    margin-bottom: 5px;
  }

  .m-b-15 {
    margin-bottom: 15px;
  }

  .p-10 {
    padding: 10px;
  }

  .p-2 {
    padding: 8px;
  }

  .p-20 {
    padding: 20px;
  }

  .font-16 {
    font-size: 16px;
  }

  .d-flex {
    display: flex;
  }

  .no-block {
